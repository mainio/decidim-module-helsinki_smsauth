<% scope = "decidim.helsinki_smsauth.verifications.admin.signin_codes.view_generated_codes.exit_confirmation" %>
<%= decidim_modal id: "backup-confirmation" do %>
  <div data-dialog-container>
    <h2 class="h2" data-dialog-title><%= t("title", scope: scope) %></h2>
    <p><%= t("codes_visibility_warning", scope: scope) %></p>
  </div>
  <div data-dialog-actions>
    <button class="button button__lg button__transparent-secondary" data-dialog-close="backup-confirmation">
      <span><%= t("cancel", scope: scope) %></span>
    </button>
    <%= link_to t("exit_modal", scope: scope), signin_code_sets_path, id: "exit-notification-link", class: "button button__lg button__secondary" %>
  </div>
<% end %>